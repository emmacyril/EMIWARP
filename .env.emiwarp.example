# ---------------------------------------------------------------------------
# EmiWarp configuration
#
# Copy to `.env.emiwarp` (repo root) or `~/.config/emiwarp/.env.emiwarp`.
# Process environment overrides the file; the file overrides the defaults.
#
# EmiWarp never contacts Warp-operated servers, so there is nothing here about
# accounts, plans, or subscriptions. Inference runs against whatever endpoint
# you point it at, using credentials you supply.
# ---------------------------------------------------------------------------

# Which backend to run inference against.
#   ollama            local Ollama daemon                       (no key needed)
#   openai            api.openai.com
#   anthropic         api.anthropic.com
#   gemini            generativelanguage.googleapis.com
#   openai_compatible any OpenAI-Chat-Completions server —
#                     vLLM, LM Studio, llama.cpp, LiteLLM,
#                     OpenRouter, Together, Groq              (key optional)
EMIWARP_AI_PROVIDER=ollama

# Endpoint root. Defaults per provider:
#   ollama            http://127.0.0.1:11434/v1
#   openai            https://api.openai.com/v1
#   anthropic         https://api.anthropic.com
#   gemini            https://generativelanguage.googleapis.com/v1beta
#   openai_compatible http://127.0.0.1:8000/v1
EMIWARP_BASE_URL=http://127.0.0.1:11434/v1

# Credential for the endpoint above. Required for openai / anthropic / gemini.
# Leave empty for Ollama and for local OpenAI-compatible servers.
EMIWARP_API_KEY=

# Model identifier as your endpoint names it.
EMIWARP_MODEL_NAME=llama3.1:8b

# Local agent CLI that EmiWarp spawns as a child process. Leave unset to use the
# default for the provider: `claude` for anthropic, `codex` for openai / ollama /
# openai_compatible, `gemini` for gemini. EmiWarp repoints the CLI at your
# endpoint through its own environment variables, so no CLI patching is needed.
# EMIWARP_HARNESS_CMD=codex

# Boot straight into the terminal workspace, skipping the onboarding splash.
EMIWARP_SKIP_ONBOARDING=true

# Product name rendered in UI chrome.
EMIWARP_BRAND_NAME=EmiWarp

# Optional local identity shown in the UI. Never transmitted.
# EMIWARP_USER_NAME=
# EMIWARP_USER_EMAIL=

# ---------------------------------------------------------------------------
# Worked examples
# ---------------------------------------------------------------------------
#
# Ollama, local:
#   EMIWARP_AI_PROVIDER=ollama
#   EMIWARP_BASE_URL=http://127.0.0.1:11434/v1
#   EMIWARP_MODEL_NAME=qwen2.5-coder:14b
#
# Anthropic:
#   EMIWARP_AI_PROVIDER=anthropic
#   EMIWARP_API_KEY=sk-ant-...
#   EMIWARP_MODEL_NAME=claude-sonnet-5
#
# OpenAI:
#   EMIWARP_AI_PROVIDER=openai
#   EMIWARP_API_KEY=sk-...
#   EMIWARP_MODEL_NAME=gpt-4o
#
# vLLM on a LAN box:
#   EMIWARP_AI_PROVIDER=openai_compatible
#   EMIWARP_BASE_URL=http://10.0.0.5:8000/v1
#   EMIWARP_MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct
